    "benchmark:dry": "node spire-demo/benchmark/run.mjs --dry-run",
    "progress": "python3 -m http.server 4390 --bind 127.0.0.1 --directory spire-demo/progress-site/dist"
  },
  "engines": {
    "node": ">=22"
  }
}