{
  "name": "jev-the-spire2",
  "private": true,
  "type": "module",
  "description": "Watch TypeSafe Jev play Slay the Spire 2. Fork of alexmeckes/jev-the-spire (MIT) with a single-call factored decision layer and latency hedging.",
  "scripts": {
    "start": "node spire-demo/server.mjs",
    "test": "node --test --test-force-exit \"spire-demo/**/*.test.mjs\"",
