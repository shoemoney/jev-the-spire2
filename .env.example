# Copy to .env, or write the same key into .private/typesafe.cfg as:  api_key = "<your key>"
#
# Jev is reached through OpenRouter's decisions endpoint:
#   POST https://openrouter.ai/api/alpha/decisions   model: typesafe/jev-1.13
# It is NOT a chat-completions model and will not work through a chat client.
# Get a key at https://openrouter.ai/keys
# Paste your key after the = sign. It starts with "sk-or-v1-".
OPENROUTER_API_KEY=

# Optional. Only needed for benchmark/vs-llm.mjs, which compares Jev against
# frontier models. Uses the same OpenRouter key above, so usually leave this unset.
# TYPESAFE_API_KEY=

# Optional runtime flags (defaults shown)
# SPIRE_SINGLE_CALL=1   # single-call factored decisions. Unset = upstream multi-call policy
# SPIRE_HEDGE=1         # set to 0 to disable request hedging
# PORT=4317             # dashboard port
